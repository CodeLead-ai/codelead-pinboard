{
  "name": "@codelead/pinboard",
  "version": "0.1.0",
  "description": "Pinboard: the board between a person and their coding agents, kept as files in the repository (cards with threads, an event log, cursors), with its command line, its page and its import.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pinboard": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./import": {
      "types": "./dist/import/index.d.ts",
      "default": "./dist/import/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:code && npm run build:page",
    "build:code": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "build:page": "vite build src/page",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/page/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "playwright": "~1.61.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
